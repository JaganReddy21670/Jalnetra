# Copy to .env.local (local) or set on your host. Never commit real values.
ADMIN_SETUP_CODE=CHANGE-ME        # needed to create the first Administrator
SESSION_SECRET=                    # long random string (auto-generated locally if empty)
DATA_DIR=                          # optional: where data is stored (default ./data)
GOOGLE_CLIENT_ID=                  # optional: enables "Sign in with Google"
ADMIN_EMAILS=                      # optional: comma-separated emails that are always admins
DATABASE_URL=                      # Postgres URL (set automatically by Vercel + Neon). If empty, data is stored in ./data
CRON_SECRET=                       # Vercel: protects /api/cron/weekly
