{
  // Cloudflare Pages project "jalnetra" (https://jalnetra.pages.dev).
  // It only forwards to the app Worker "jalnetra-app" through a service binding.
  "name": "jalnetra",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-11-01",
  "services": [{ "binding": "APP", "service": "jalnetra-app" }]
}
